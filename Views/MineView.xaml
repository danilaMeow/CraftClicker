<UserControl x:Class="MyApp.Views.MineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
            <TextBlock Text="⛏️ ШАХТА" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Сетка 3x3 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="110" Height="110" Margin="6" 
                            Command="{Binding DataContext.ClickCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="BorderBrush" Value="#555555"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoldenNode}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                        <Setter Property="Background" Value="#3A3210"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMined}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding CurrentDurability}" Maximum="{Binding MaxDurability}" 
                                             Height="8" Width="80" Margin="0,8,0,0" Foreground="#007ACC" Background="#1E1E1E"/>
                                <TextBlock Text="{Binding CurrentDurability}" Foreground="#888888" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Панель управления (Сброс по кнопке / R) -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Center">
            <Button Content="Пересоздать сетку (R)" 
                    Command="{Binding ResetGridCommand}"
                    IsEnabled="{Binding CanReset}"
                    Height="36" Width="220" 
                    Background="#0E639C" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>