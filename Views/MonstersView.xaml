<UserControl x:Class="MyApp.Views.MonstersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
            <TextBlock Text="⚔️ МОНСТРЫ" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 5 ячеек в ряд -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Monsters}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="100" Height="120" Margin="5" 
                            Command="{Binding DataContext.ClickMonsterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#331A1A"/>
                                <Setter Property="BorderBrush" Value="#8B0000"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDead}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <ProgressBar Value="{Binding CurrentHp}" Maximum="{Binding MaxHp}" 
                                         Height="8" Width="70" Margin="0,8,0,0" Foreground="#E51400" Background="#1E1E1E"/>
                            <TextBlock Text="{Binding CurrentHp}" Foreground="#888888" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Center">
            <Button Content="Пересоздать монстров (R)" 
                    Command="{Binding ResetGridCommand}"
                    IsEnabled="{Binding CanReset}"
                    Height="36" Width="220" 
                    Background="#A20025" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>