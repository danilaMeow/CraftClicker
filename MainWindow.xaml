<Window x:Class="MyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyApp.ViewModels"
        xmlns:views="clr-namespace:MyApp.Views"
        Title="CraftClicker" 
        WindowState="Maximized"
        WindowStyle="None"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MineViewModel}">
            <views:MineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HarvestLocationViewModel}">
            <views:MineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonstersViewModel}">
            <views:MonstersView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Сетка макета -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель навигации -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="CRAFT CLICKER" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <Button Content="⛏️ Шахта" Command="{Binding SelectLocationCommand}" CommandParameter="Mine" Margin="0,3" Height="32"/>
                <Button Content="🪓 Лес" Command="{Binding SelectLocationCommand}" CommandParameter="Forest" Margin="0,3" Height="32"/>
                <Button Content="🌾 Поле" Command="{Binding SelectLocationCommand}" CommandParameter="Field" Margin="0,3" Height="32"/>
                <Button Content="⚔️ Монстры" Command="{Binding SelectLocationCommand}" CommandParameter="Monsters" Margin="0,3" Height="32"/>
                <Button Content="🌱 Огород" Margin="0,3" Height="32"/>
                <Separator Margin="0,10" Background="#3F3F46"/>
                <Button Content="🔨 Крафт" Margin="0,3" Height="32"/>
                <Button Content="🔥 Печь" Margin="0,3" Height="32"/>
                <Button Content="🧪 Алхимия" Margin="0,3" Height="32"/>
                <Button Content="⚖️ Рынок" Margin="0,3" Height="32"/>
                <Button Content="🏛️ Алтарь" Margin="0,3" Height="32"/>
            </StackPanel>
        </Border>

        <!-- Рабочая область -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="15"/>

        <!-- Правый инвентарь -->
        <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="🎒 Инвентарь" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <ListBox ItemsSource="{Binding Inventory.Items}" Background="#1E1E1E" BorderThickness="0" Margin="0,5,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='x{0}'}" Foreground="#FFCC00" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Красная кнопка выхода сверху справа -->
        <Button Grid.Column="2" 
                Content="✕" 
                Click="CloseButton_Click"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Width="40" 
                Height="32" 
                Margin="0,0,0,0"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                Cursor="Hand"
                ToolTip="Закрыть приложение">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#C75050"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="0,0,0,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E81123"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#990000"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>